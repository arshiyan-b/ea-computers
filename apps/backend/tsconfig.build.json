{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Without an explicit rootDir, tsc infers it from the common ancestor of
    // every compiled file — and prisma/seed.ts (outside src/) was pulling
    // that ancestor up to the project root, nesting output under dist/src/
    // instead of dist/, breaking `node dist/main.js` (and start:prod).
    "rootDir": "src"
  },
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*spec.ts"]
}
