# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ea_computers?schema=public"

# --- App ----------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# --- Cart (guest cart cookie) ---------------------------------------------
CART_COOKIE_NAME="ea_cart_sid"
CART_COOKIE_SECRET="change-me-too-another-long-random-string"

# --- File storage -----------------------------------------------------------
# "local" | "s3" | "cloudinary"
STORAGE_PROVIDER=local

# S3 / any S3-compatible provider (e.g. MinIO, DigitalOcean Spaces, Cloudflare R2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Cloudinary (optional alternative)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (reserved for future caching / rate-limit / queue use) -----------
REDIS_URL="redis://localhost:6379"

# --- Frontend (consumed by Next.js / Refine, listed here for reference) ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
